FROM node:20-alpine AS frontend-builder

WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim

LABEL maintainer="John Akech <j.akech@alustudent.com>"
LABEL description="FloodSense Full Stack - Heroku Deployment"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=5 \
    PORT=8000

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    nginx \
    && rm -rf /var/lib/apt/lists/*

# Copy frontend build
COPY --from=frontend-builder /frontend/dist /usr/share/nginx/html

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

COPY backend/requirements.txt .

# Install PyTorch CPU version
RUN pip install --no-cache-dir --timeout=300 torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu || \
    pip install --no-cache-dir --timeout=300 torch==2.5.1

# Install FastAPI and core dependencies
RUN pip install --no-cache-dir --timeout=300 \
    fastapi==0.110.0 \
    uvicorn[standard]==0.27.1 \
    sqlalchemy==2.0.28 \
    pydantic>=2.6.0 \
    pydantic-settings==2.1.0

# Install data science libraries
RUN pip install --no-cache-dir --timeout=300 \
    pandas==2.2.3 \
    numpy==1.26.4 \
    scikit-learn==1.5.2 \
    joblib==1.3.2 \
    imbalanced-learn==0.12.4

# Install additional dependencies
RUN pip install --no-cache-dir --timeout=300 \
    email-validator>=2.0.0 \
    geopy==2.4.1 \
    folium==0.15.1 \
    python-jose[cryptography]==3.3.0 \
    passlib[bcrypt]==1.7.4 \
    python-multipart==0.0.9

# Install dev and database dependencies
RUN pip install --no-cache-dir --timeout=300 \
    pytest==7.4.3 \
    pytest-cov==4.1.0 \
    httpx==0.25.2 \
    earthengine-api==0.1.384 \
    cryptography==41.0.7 \
    psycopg2-binary==2.9.9

# Copy backend code
COPY backend/ .

# Create necessary directories
RUN mkdir -p database logs models && \
    useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

# Copy models
COPY models/ ./models/

# Copy nginx config for Heroku
COPY heroku-nginx.conf /etc/nginx/nginx.conf

USER appuser

EXPOSE $PORT

# Start script that runs both nginx and uvicorn
COPY start-heroku.sh /start.sh
USER root
RUN chmod +x /start.sh
USER appuser

CMD ["/start.sh"]
