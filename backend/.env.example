# South Sudan Flood Prediction System - Environment Configuration

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32

# JWT token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# SQLite (Development)
DATABASE_URL=sqlite:///./app/flood_prediction.db

# PostgreSQL (Production - Recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/flooddb

# MySQL (Alternative)
# DATABASE_URL=mysql://user:password@localhost:3306/flooddb

# =============================================================================
# API SETTINGS
# =============================================================================
# API version prefix
API_V1_PREFIX=/api/v1

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# MODEL SETTINGS
# =============================================================================
# Model file paths (relative to project root)
RANDOM_FOREST_MODEL_PATH=../../models/random_forest.pkl
TCN_MODEL_PATH=../../models/tcn_model.pt
PROTOTYPICAL_MODEL_PATH=../../models/prototypical_model.pt

# Default model for predictions
DEFAULT_MODEL=rf

# Model confidence threshold
CONFIDENCE_THRESHOLD=0.5

# =============================================================================
# GIS SETTINGS
# =============================================================================
# Default map center (South Sudan)
DEFAULT_LATITUDE=6.877
DEFAULT_LONGITUDE=31.307
DEFAULT_ZOOM=7

# Alert radius (kilometers)
DEFAULT_ALERT_RADIUS_KM=50

# =============================================================================
# ALERT SETTINGS
# =============================================================================
# Alert expiration (hours)
ALERT_EXPIRATION_HOURS=24

# Flood probability thresholds
LOW_RISK_THRESHOLD=0.4
MEDIUM_RISK_THRESHOLD=0.6
HIGH_RISK_THRESHOLD=0.8

# =============================================================================
# NOTIFICATION SETTINGS (Optional)
# =============================================================================
# Email notifications (SMTP)
# REQUIRED FOR EMAIL ALERTS - Choose one provider:
#
# Option 1: Gmail (requires app-specific password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=noreply@floodprediction.org
# SMTP_USE_TLS=true
#
# Option 2: SendGrid (recommended for production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key
# SMTP_FROM=noreply@floodprediction.org
# SMTP_USE_TLS=true
#
# Option 3: AWS SES (requires AWS credentials)
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-aws-smtp-username
# SMTP_PASSWORD=your-aws-smtp-password
# SMTP_FROM=verified-sender@yourdomain.com
# SMTP_USE_TLS=true
#
# Option 4: Mailgun
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.mailgun.org
# SMTP_PASSWORD=your-mailgun-smtp-password
# SMTP_FROM=noreply@floodprediction.org
# SMTP_USE_TLS=true
#
# Frontend URL (for verification links)
# FRONTEND_URL=http://localhost:3000

# SMS notifications (Twilio)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Web Push notifications
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:admin@floodprediction.org

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/app.log

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Debug mode (set to False in production!)
DEBUG=True

# Auto-reload on code changes
RELOAD=True

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Server settings
# HOST=0.0.0.0
# PORT=8000
# WORKERS=4

# SSL/TLS
# SSL_KEYFILE=/path/to/keyfile.pem
# SSL_CERTFILE=/path/to/certfile.pem

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Google Earth Engine (for real-time data)
# GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
# GEE_PRIVATE_KEY_PATH=/path/to/private-key.json

# Weather API (for precipitation data)
# WEATHER_API_KEY=your-api-key
# WEATHER_API_URL=https://api.weatherapi.com/v1

# =============================================================================
# MONITORING & ANALYTICS (Optional)
# =============================================================================
# Sentry (Error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics
# GA_TRACKING_ID=UA-XXXXXXXXX-X

# =============================================================================
# BACKUP SETTINGS
# =============================================================================
# Database backup directory
BACKUP_DIR=backups/

# Backup retention (days)
BACKUP_RETENTION_DAYS=30
