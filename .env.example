# FloodSense Environment Configuration

# Backend Security
SECRET_KEY=your-super-secret-key-change-in-production-use-secrets.token_urlsafe(32)
DATABASE_URL=sqlite:///./database/floodsense.db
ENVIRONMENT=development

# Google Earth Engine
GEE_PROJECT_ID=your-gee-project-id

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:80,http://localhost:3000

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# IP Whitelist for Admin Endpoints (comma-separated)
IP_WHITELIST=127.0.0.1,::1

# Password Policy
MIN_PASSWORD_LENGTH=8
REQUIRE_SPECIAL_CHAR=true
REQUIRE_UPPERCASE=true
REQUIRE_NUMBER=true

# Optional: Production Database (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/floodsense
