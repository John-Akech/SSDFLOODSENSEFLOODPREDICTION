# ============================================================================
# FloodSense Environment Configuration
# Copy this file to .env and update with your actual values
# ============================================================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For local development (SQLite)
DATABASE_URL=sqlite:///./database/floodsense.db

# For production (PostgreSQL) - uncomment and configure
# DATABASE_URL=postgresql://floodsense_user:floodsense_password@db:5432/floodsense_db

# ============================================
# SECURITY SETTINGS
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Security Headers
FORCE_HTTPS=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ============================================
# CORS CONFIGURATION
# ============================================
# For local development
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:80,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:80

# For production, add your domain (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

# ============================================
# RATE LIMITING & SECURITY
# ============================================
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# IP Whitelist for Admin Endpoints (comma-separated)
IP_WHITELIST=127.0.0.1,::1

# Password Policy
MIN_PASSWORD_LENGTH=8
REQUIRE_SPECIAL_CHAR=true
REQUIRE_UPPERCASE=true
REQUIRE_NUMBER=true

# ============================================
# WEB PUSH NOTIFICATIONS (VAPID)
# ============================================
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@floodsense.org

# ============================================
# SERVICE URLS (Internal Docker Network)
# ============================================
# SAR Detection Service URL (backend to SAR communication)
SAR_SERVICE_URL=http://sar-detection:8080

# ============================================
# GOOGLE EARTH ENGINE CONFIGURATION
# ============================================
GEE_PROJECT_ID=ace-connection-474712-p1

# For local development - path to service account JSON file
# Mount the file as volume in docker-compose.yml
# GEE_SERVICE_ACCOUNT_KEY=/app/gee-service-account-key.json

# For production - base64 encoded service account JSON
# Set this in your deployment platform (DigitalOcean App Spec, etc.)
# GEE_SERVICE_ACCOUNT_KEY_BASE64=<base64_encoded_json>

# ============================================
# ENVIRONMENT MODE
# ============================================
ENVIRONMENT=development
# For production: ENVIRONMENT=production

# ============================================
# PRODUCTION DEPLOYMENT (DigitalOcean/Cloud)
# ============================================
# Uncomment and configure for production deployments
# DROPLET_IP=your.server.ip.address
# TAG=latest
